---
# Example: Vault Token Secret for Terraform
#
# IMPORTANT: This file is an example only!
#
# To use:
# 1. Copy this file to vault-token-secret.yaml (it's gitignored)
# 2. Replace YOUR_VAULT_ROOT_TOKEN with your actual Vault root token
# 3. Apply manually: kubectl apply -f vault-token-secret.yaml
#
# For production, use External Secrets Operator or sealed-secrets to manage this
#
apiVersion: v1
kind: Secret
metadata:
  name: vault-terraform-vars
  namespace: flux-system
type: Opaque
stringData:
  vault_token: "YOUR_VAULT_ROOT_TOKEN"
